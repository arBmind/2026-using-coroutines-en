{
  "name": "Meeting C++ 2026 Slidev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "slides",
  "workspaceFolder": "/workspaces/2026-11_UsingCoroutines",
  "forwardPorts": [3030],
  "portsAttributes": {
    "3030": {
      "label": "Slidev",
      "onAutoForward": "notify"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspaces/2026-11_UsingCoroutines,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex,target=/home/node/.codex,type=bind,consistency=delegated"
  ],
  "postCreateCommand": "npm install && npx playwright install chromium && src/snippets/build.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "antfu.slidev",
        "Vue.volar",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools",
        "openai.chatgpt",
        "esbenp.prettier-vscode",
        "gxl.git-graph-3"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "slidev.include": ["src/slides.md"],
        "slidev.dev-command": "npm run dev -- --port ${port}",
        "chatgpt.runCodexInWindowsSubsystemForLinux": true
      }
    }
  },
  "remoteUser": "node",
  "containerUser": "node",
  "updateRemoteUserUID": true
}
